[Unit]
Description: Captain Habitat: Live Captain Operational Runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cgl
Group=cgl
WorkingDirectory=/home/cgl/dev/monad
ExecStart=/usr/bin/python3 /home/cgl/dev/monad/tools/live-captain/habitat_server.py --port 4777
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
