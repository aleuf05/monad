(console_routes) {
	handle_path /chat-captain-api/* {
		reverse_proxy 127.0.0.1:4778
	}
	handle {
		root * /home/cgl/dev/monad/console
		file_server
	}
}

cameronlampley.com {
	encode zstd gzip

	# LAN-direct branch: viable only once LAN clients resolve this hostname
	# straight to 192.168.0.100 via router-side DNS (see docs/deployment.md).
	# That path never touches the router's NAT hairpin, so remote_ip here
	# is the client's real private address -- unlike the disproved
	# same-hostname-via-hairpin attempt, where source was rewritten to the
	# public WAN IP and looked identical to real internet traffic.
	@lan remote_ip private_ranges
	handle @lan {
		import console_routes
	}

	handle_path /monad/portainer/* {
		reverse_proxy https://localhost:9443 {
			transport http {
				tls_insecure_skip_verify
			}
			header_up Host {upstream_hostport}
		}
	}

	handle_path /fleetcore-ws/* {
		reverse_proxy 127.0.0.1:4771
	}

	handle_path /captain-memory-api/* {
		reverse_proxy 127.0.0.1:4772
	}

	handle_path /world-intake-api/* {
		reverse_proxy 127.0.0.1:4773
	}

	handle_path /living-captain-api/* {
		reverse_proxy 127.0.0.1:4774
	}

	handle_path /live-captain-chat-api/* {
		reverse_proxy 127.0.0.1:4776
	}

	handle_path /libfive-api/* {
		reverse_proxy 127.0.0.1:4787
	}

	handle_path /mike-rocketry-intake-api/* {
		reverse_proxy 127.0.0.1:4789
	}

	handle_path /captain-workbench-api/* {
		reverse_proxy 127.0.0.1:4791
	}

	handle {
		root * /home/cgl/dev/monad/web
		file_server
	}
}

# Monad Root Console -- LAN-only Chat Captain cockpit. Deliberately NOT part
# of the public cameronlampley.com block above: matched by LAN IP, plain
# HTTP (no public cert is obtainable for a bare LAN address), not reachable
# from the public internet. Narrow, single-console exception to the
# web-lan/ pattern retired 2026-07-13 -- see docs/deployment.md for the
# discussion that authorized this one instance.
http://192.168.0.100:8080 {
	import console_routes
}
