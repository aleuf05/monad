(console_routes) {
	handle_path /chat-captain-api/* {
		respond `{"error":"legacy_chat_captain_parked"}` 410
	}
	handle {
		root * /home/cgl/dev/monad/console
		file_server
	}
}

cameronlampley.com {
	encode zstd gzip

	# Everything below is wrapped in one explicit `route` block. Caddy's
	# automatic Caddyfile directive ordering does NOT preserve file order
	# here -- confirmed repeatedly via `caddy adapt`: handle vs
	# handle_path, and even route vs handle, got silently resorted by
	# path specificity/directive type rather than file position (e.g. the
	# unconditional catch-all handle{} at the bottom of this file was
	# sorted BEFORE a route{} block placed near the top). `route` disables
	# that automatic reordering entirely and runs its contents in the
	# exact sequence written, so every matcher below is evaluated
	# top-to-bottom, first match wins, exactly as it reads.
	route {
		# Single site, single path to the console: cameronlampley.com/root,
		# for the Admiral from anywhere including the LAN. No separate
		# bare-IP LAN site block and no split-horizon @lan branch -- both
		# retired 2026-08-01 in favor of exactly one Caddy site. This path
		# is reachable by anyone on the internet, so it is gated --
		# password-only (this page has exactly one intended user, no
		# username field) by
		# tools/public-root-auth/server.py via forward_auth. That service
		# issues a 1-year session cookie on successful login, so this
		# reads as "log in once," not a per-visit prompt. /root-login
		# itself must stay unauthenticated -- it's the login form.
		# /root (no trailing slash) is redirected explicitly -- it does
		# not match /root/* on its own, and typing the URL without a
		# trailing slash is the natural/common case.
		# handle, not handle_path -- the backend expects the literal
		# /root-login path; handle_path would strip it to empty and the
		# backend's own path check would never match (confirmed live).
		handle /root-login* {
			reverse_proxy 127.0.0.1:4779
		}
		redir /root /root/ 308
		# /check-page (not /check) -- unlike /chat-captain-api/* below,
		# this gates a real browser page load, so on failure it should
		# redirect to the login form rather than return a bare 401. That
		# redirect must come from the upstream auth check itself: Caddy's
		# forward_auth returns any non-2xx response directly to the
		# client, and handle_errors cannot intercept it (it's a normal
		# response, not a Caddy "error" -- confirmed live).
		handle_path /root/* {
			forward_auth 127.0.0.1:4779 {
				uri /check-page
			}
			import console_routes
		}

		handle_path /chat-captain-api/* {
			respond `{"error":"legacy_chat_captain_parked"}` 410
		}

		handle_path /root-console-api/* {
			forward_auth 127.0.0.1:4779 {
				uri /check
			}
			reverse_proxy 127.0.0.1:4792
		}

		handle_path /monad/portainer/* {
			reverse_proxy https://localhost:9443 {
				transport http {
					tls_insecure_skip_verify
				}
				header_up Host {upstream_hostport}
			}
		}

		handle_path /fleetcore-ws/* {
			reverse_proxy 127.0.0.1:4771
		}

		handle_path /captain-memory-api/* {
			reverse_proxy 127.0.0.1:4772
		}

		handle_path /world-intake-api/* {
			reverse_proxy 127.0.0.1:4773
		}

		handle_path /living-captain-api/* {
			reverse_proxy 127.0.0.1:4774
		}

		handle_path /live-captain-chat-api/* {
			reverse_proxy 127.0.0.1:4776
		}

		handle_path /libfive-api/* {
			reverse_proxy 127.0.0.1:4787
		}

		handle_path /mike-rocketry-intake-api/* {
			reverse_proxy 127.0.0.1:4789
		}

		handle_path /captain-workbench-api/* {
			reverse_proxy 127.0.0.1:4791
		}

		handle_path /monad0-lab-api/* {
			reverse_proxy 127.0.0.1:4793
		}

		handle {
			root * /home/cgl/dev/monad/web
			file_server
		}
	}
}
