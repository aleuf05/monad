[Unit]
Description=Monad Mike rocketry GLB quarantine intake
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cgl
Group=cgl
WorkingDirectory=/home/cgl/dev/monad/tools/mike-rocketry
ExecStart=/usr/bin/python3 /home/cgl/dev/monad/tools/mike-rocketry/glb_intake.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
