[Unit]
Description=Monad Live Captain minimum-context bootstrap (LIVE-CAPTAIN-MINIMUM-CONTEXT-BOOTSTRAP-0.1; loopback-only, reached via Caddy's /live-captain-bootstrap-api/* proxy on cameronlampley.com/root)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cgl
Group=cgl
WorkingDirectory=/home/cgl/dev/monad/tools/live-captain
EnvironmentFile=/home/cgl/.config/monad/root-console.env
ExecStart=/usr/bin/python3 /home/cgl/dev/monad/tools/live-captain/server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/cgl/dev/monad/data/live-captain
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
