[Unit]
Description=Monad Live Captain Private Conference (authenticated, loopback only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cgl
Group=cgl
WorkingDirectory=/home/cgl/dev/monad
EnvironmentFile=/home/cgl/.config/monad/gemini.env
EnvironmentFile=/home/cgl/.config/monad/live-captain-web.env
ExecStart=/usr/bin/python3 /home/cgl/dev/monad/tools/living-captain/web_service.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/cgl/dev/monad/data/living-captain
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
